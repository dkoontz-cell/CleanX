{
  "manifest_version": 3,
  "name": "CleanX Local",
  "description": "Locally modified CleanX: country, region and script filters with private local storage and safer lookups.",
  "version": "1.1.1",
  "minimum_chrome_version": "111",
  "permissions": ["storage"],
  "content_scripts": [
    { "matches": ["https://x.com/*", "https://twitter.com/*"], "js": ["page.js"], "run_at": "document_start", "world": "MAIN" },
    { "matches": ["https://x.com/*", "https://twitter.com/*"], "js": ["cleanx.js"], "run_at": "document_start" }
  ]
}
